// Sharky theme
// Optional built-in presets: catppuccin, tokyonight, sharky, neolambda, pure, robbyrussell, powerline
// style preset catppuccin

// Palette
color bg     #071923
color fg     #E4F5F4
color accent #35B8C5
color ok     #8CCFA8
color danger #FF8F80
color muted  #6C8A96

// Prompt
style prompt "{cwd}[ {git}{git_dirty}][ {duration}] {symbol} "
style prompt.symbol.glyph "❯"
style prompt.cwd @ok
style prompt.git @accent
style prompt.git_dirty @danger
style prompt.duration @muted
style prompt.symbol @accent
style prompt.error "@danger bold"

// Syntax highlighting
style command @fg
style builtin @accent
style string @ok
style variable @accent
style error @danger

// Suggestions & selection
style suggestion @muted
style selection "@bg on @accent"
