// Sharky configuration
// One statement per line: instruction property value

// Shell behaviour
set greeting off
set autosuggest on
set highlight on
set history 10000
// set cursor beam
// set vi off
// set transient_prompt off
// Prompt engine: native (default), starship, or omp (Oh My Posh)
// set prompt native
// set prompt starship
// set prompt omp
// set omp_config "~/.config/oh-my-posh/theme.omp.json"
// set rprompt on

// Environment
env EDITOR "nvim"
env BROWSER "firefox"

// Extra PATH entries, prepended in order
path "~/.cargo/bin"
path "~/.local/bin"

// Startup commands, run once before the first prompt
// startup "fastfetch"

// Abbreviations expand when you press space or Enter
// abbr gco "git checkout"

// Aliases
alias ll "ls -lah"
alias gs "git status"
alias cls "clear"

// Key bindings
bind ctrl+r history_search
bind tab complete
// bind alt+left dir_back
// bind alt+right dir_forward

// Optional modular overrides: files in conf.d/*.sharky load automatically,
// or include a file explicitly:
// include "local.sharky"
