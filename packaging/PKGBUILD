# Maintainer: sharky maintainers
pkgname=sharky
pkgver=1.0.0
pkgrel=1
pkgdesc="Unix-first interactive shell written in Ruby"
arch=('any')
url="https://github.com/mafuzyk/sharky-shell"
license=('GPL-3.0-only')
depends=('ruby')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

package() {
  cd "${pkgname}"
  make install DESTDIR="${pkgdir}" PREFIX=/usr
}
